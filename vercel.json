{
  "builds": [
    {
      "src": "src/backend/app.py",
      "use": "@vercel/python"
    },
    {
      "src": "src/frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/src/backend/app.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/src/frontend/dist/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/src/frontend/dist/index.html"
    }
  ]
}
